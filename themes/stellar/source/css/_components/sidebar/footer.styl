.l_left footer.footer
  margin: 0.5rem var(--gap-base) 1rem

.social-wrap
  display: grid
  grid-gap: 0.25rem 0.25rem
  grid-template-columns: repeat(auto-fill, 32px)
  text-align: center
  .social
    line-height: 0
    display: inline-block
    padding: 6px
    border-radius: 32px
    filter: grayscale(100%)
    overflow: hidden
    background: transparent
    trans3: box-shadow background transform
    &:hover
      z-index: 1
      filter: unset
      background: var(--bg-a100)
    img
      border-radius: 2px

.l_left footer.footer
  .language-switcher
    display: block
    margin-top: .5rem
    overflow: visible
    cursor: pointer
    summary
      list-style: none
      box-sizing: border-box
      min-height: 36px
      display: flex
      align-items: center
      justify-content: center
      padding: 0 16px
      border-radius: $border-bar
      color: var(--text-p2)
      cursor: pointer
      &::-webkit-details-marker
        display: none
      &:hover
        color: var(--text-p1)
        sidebar-light()
    &[open] summary
      color: var(--text-p1)
      sidebar-light()
    .language-options
      display: flex
      flex-direction: column
      gap: 2px
      margin: 0 4px 4px
      padding: 4px
      border-radius: $border-bar
      background: var(--bg-a50)
    .language-option
      min-height: 32px
      display: flex
      align-items: center
      padding: 0 12px
      border-radius: $border-bar
      color: var(--text-p2)
      text-decoration: none
      &:hover, &.active
        color: var(--text-p1)
        background: var(--bg-a60)
      &.unavailable
        opacity: .72
      .active-dot
        margin-left: auto
