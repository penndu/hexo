.nav-area .menu
  width: 100%
  display: flex
  flex-direction: column
  gap: 4px
  margin: 0
  &::-webkit-scrollbar
    display: none
  &::-webkit-scrollbar-track-piece
    background: transparent
  &::-webkit-scrollbar-thumb
    display: none
  
  .nav-item
    box-sizing: border-box
    width: 100%
    min-height: 36px
    border-radius: $border-bar
    font-size: $fs-15
    color: var(--text-p2)
    text-align: left
    position: relative
    display: flex
    flex-direction: row
    font-weight: 500
    align-items: center
    justify-content: flex-start
    gap: 16px
    padding: 0 16px
    color: var(--text-p2)
    // 菜单项主题色由配置内联提供（--item-theme），淡色变体在此基于它计算
    --item-theme-light: x-theme-light()
    img,svg
      width: 1.5rem
      height: 1.5rem
      object-fit: contain
      opacity: 0.5
      color: var(--text-p2)
    span
      text-overflow: ellipsis
      word-break: keep-all
    &:hover
      color: var(--text-p1)
      sidebar-light()
      img,svg
        opacity: 1
      > svg [fill="currentColor"]
        fill: var(--item-grad)
      > svg [stroke="currentColor"]
        stroke: var(--item-grad)
    &.active
      color: var(--text-p1)
      sidebar-light()
      img,svg
        opacity: 1
      .active-dot
        flex-shrink: 0
        margin-left: auto
        width: 8px
        height: 8px
        border-radius: 50%
        corner-shape: round
        background: x-theme-gradient()
      > svg [fill="currentColor"]
        fill: var(--item-grad)
      > svg [stroke="currentColor"]
        stroke: var(--item-grad)
    // 未设置主题色的菜单项，激活/悬停时图标显示通用主题色
    &:not(.themed)
      &:hover, &.active
        > svg
          color: var(--theme)
    // 设置了主题色的菜单项：主题色只作用于图标，文字保持标准色
    &.themed
      &:hover, &.active
        > svg
          color: var(--item-theme)

  .language-switcher
    display: block
    padding: 0
    overflow: visible
    cursor: pointer
    summary
      list-style: none
      box-sizing: border-box
      min-height: 36px
      display: flex
      align-items: center
      padding: 0 16px
      cursor: pointer
      &::-webkit-details-marker
        display: none
    &[open] summary
      color: var(--text-p1)
      sidebar-light()
    .language-options
      display: flex
      flex-direction: column
      gap: 2px
      margin: 0 4px 4px
      padding: 4px
      border-radius: $border-bar
      background: var(--bg-a50)
    .language-option
      min-height: 32px
      display: flex
      align-items: center
      padding: 0 12px
      border-radius: $border-bar
      color: var(--text-p2)
      text-decoration: none
      &:hover, &.active
        color: var(--text-p1)
        background: var(--bg-a60)
      &.unavailable
        opacity: .72
      .active-dot
        margin-left: auto
