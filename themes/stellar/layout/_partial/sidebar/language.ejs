<%
var languageItems = language_versions(page)
var el = '<details class="language-switcher nav-item">'
el += `<summary title="${escape_html(__('btn.language'))}">`
el += `<span>${escape_html(__('btn.language'))}</span>`
el += '</summary>'
el += '<div class="language-options">'
for (let language of languageItems) {
  if (language.available) {
    el += `<a class="language-option${language.current ? ' active' : ''}" href="${escape_html(language.href)}" hreflang="${escape_html(language.code)}">`
  } else {
    el += '<span class="language-option unavailable" aria-disabled="true">'
  }
  el += `<span>${escape_html(language.title)}</span>`
  if (language.current) el += '<span class="active-dot"></span>'
  el += language.available ? '</a>' : '</span>'
}
el += '</div></details>'
%><%- el %>
